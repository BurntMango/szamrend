#!/bin/bash

# Ellenőrizzük, hogy megadtak-e pontosan 2 paramétert
if [[ $# -ne 2 ]]; then
    echo "Hiba: Két paraméter szükséges: <fájl> <karakter>" >&2
    exit 1
fi

# Paraméterek beolvasása
file=$1
char=$2

# Ellenőrizzük, hogy a fájl létezik-e
if [[ ! -f $file ]]; then
    echo "Hiba: A megadott fájl nem létezik: $file" >&2
    exit 1
fi

# Ellenőrizzük, hogy pontosan egy karaktert kaptunk-e
if [[ ${#char} -ne 1 ]]; then
    echo "Hiba: A második paraméternek egyetlen karakternek kell lennie." >&2
    exit 1
fi

# Karakter előfordulásainak számolása
count=$(grep -o "$char" "$file" | wc -l)

# Eredmény kiírása
echo "A(z) '$char' karakter $count alkalommal fordul elő a fájlban."
