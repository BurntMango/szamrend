# A fájl elérési útja a script futásának helyén
$filePath = ".\cica.txt"

# Ellenőrizzük, hogy a fájl létezik-e
if (Test-Path $filePath) {
    # Beolvassuk a fájl sorait, és meghatározzuk a sorok számát
    $lineCount = (Get-Content $filePath).Count
    Write-Output "A fájl sorainak száma: $lineCount"
} else {
    Write-Output "A 'cica.txt' fájl nem található!"
}
